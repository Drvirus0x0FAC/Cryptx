# CrypTX environment configuration
# Copy to .env and fill in values. NEVER commit the real .env.

# ── REQUIRED for production ──────────────────────────────────────────────────
# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, CrypTX auto-generates one and writes it to backend/.auth_secret —
# but for production you MUST set this explicitly so tokens survive redeploys.
AUTH_SECRET=

# Base URL of the deployment (used for SSO callbacks, absolute links).
BASE_URL=http://localhost

# ── Local node / air-gap RPC (makes self-hosted deployment real) ───────────
# When set, EVM fetchers (holistic trace, address lookup) prefer a local node
# over public block explorers. No investigation data leaves the deployment.
# Format: JSON map of chain→URL, or a single URL (maps to eth only).
# Examples:
#   LOCAL_RPC_URLS={"eth":"http://localhost:8545","base":"http://localhost:8547"}
#   LOCAL_RPC_URLS=http://localhost:8545
# Legacy single-chain shortcut (equivalent to LOCAL_RPC_URLS for eth only):
# ETH_RPC_URL=http://localhost:8545
# LOCAL_RPC_URLS=

# ── Database ────────────────────────────────────────────────────────────────
# SQLite path (relative to backend/ or absolute). Defaults to backend/cryptoosint.db.
# In Docker this is set to /app/backend/data/cryptoosint.db and persisted via volume.
# DB_PATH=

# ── Multi-tenancy ───────────────────────────────────────────────────────────
# Set to 0 to disable org scoping (legacy single-user mode). Default: enabled.
# MULTI_TENANT=1
# Pre-seeded default org id for existing deployments. If unset, a default org is
# created on first user registration.
# DEFAULT_ORG_ID=

# ── RFC-3161 Trusted Timestamping (court-admissibility) ─────────────────────
# Set to an accredited TSA URL to enable trusted timestamping on evidence.
# Examples: http://timestamp.digicert.com, http://tsa.sepior.com
# For air-gapped: point at a self-hosted TSA on the local network.
# TSA_URL=

# ── CORS (comma-separated origins; localhost dev ports are always allowed) ──
# CORS_ORIGINS=https://cryptx.yourdomain.com

# ── SSO / OIDC (one block per provider; provider name is case-insensitive) ──
# Example: Google
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_DISCOVERY_URL=https://accounts.google.com
# OIDC_GOOGLE_SCOPES=openid email profile
#
# JIT provisioning: auto (create users on first SSO login) or prompt (require admin)
# OIDC_JIT_PROVISION=auto
# Org to assign JIT-provisioned users (defaults to the auto-created default org)
# OIDC_DEFAULT_ORG_ID=

# ── External data-source API keys (optional but recommended) ────────────────
# Configure via the in-app Settings page, OR set here for headless deploys.
# ETHERSCAN_API_KEY=
# ARKHAM_API_KEY=
# CHAINALYSIS_API_KEY=
# SCAMSEARCH_API_KEY=
# BLOCKCYPHER_TOKEN=
# THEGRAPH_API_KEY=
# ETHPLORER_API_KEY=
# UD_API_KEY=
# DUNE_API_KEY=

# ── AI provider (for the AI agent / copilot) ───────────────────────────────
# AI_PROVIDER=DEEPSEEK
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Deployment metadata ────────────────────────────────────────────────────
ENVIRONMENT=production
